# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Subscribed ICS calendar -------------------------------------------------
# The full URL of the .ics feed (webcal:// links -> swap to https://).
ICS_URL=https://example.com/path/to/schedule.ics

# HTTP Basic Auth credentials required by the calendar host.
ICS_USERNAME=
ICS_PASSWORD=

# Space reserved for whatever bespoke headers the calendar host ends up
# requiring. Their documentation is still being written, so leave this as
# an empty JSON object ({}) until there's something real to put here.
# Example once known:
# ICS_EXTRA_HEADERS={"X-Api-Key": "abc123", "Accept": "text/calendar"}
ICS_EXTRA_HEADERS={}

# Seconds to wait for the calendar host to respond before giving up.
ICS_REQUEST_TIMEOUT_SECONDS=30

# Set true to log the exact outgoing request (method/URL/headers) and the
# response (status/headers/body preview) -- or the full exception chain if
# the connection drops before any response. Credentials/tokens are redacted
# before logging. Useful for diffing against what a real browser sends.
# Also gates the equivalent verbose per-request logging for AeroAPI polls
# (aeroapi_client.py) -- one flag for "log outbound API calls verbosely".
ICS_DEBUG=false

# --- Refresh / board behavior -------------------------------------------------
# Header text shown at the top of the board and in the browser tab. Lets
# each install be personalized (e.g. "The Smiths' Flight Board") without
# touching code. Rendered in all-caps by the board's styling regardless of
# how it's typed here.
BOARD_TITLE=Flight Status

# How often (minutes) the client re-pulls the subscribed calendar.
REFRESH_INTERVAL_MINUTES=15

# How soon (seconds) to retry after a *failed* calendar fetch, instead of
# waiting the full REFRESH_INTERVAL_MINUTES. Matters most right after boot
# on an auto-starting install (e.g. a Raspberry Pi via systemd) where the
# network/DNS might not be ready yet for the very first attempt.
REFRESH_RETRY_SECONDS=60

# How long (minutes) a flight stays displayed as "current" after its
# scheduled arrival time before the board advances to the next flight.
ARRIVAL_GRACE_MINUTES=15

# Window (days) around "now" used when expanding calendar events, mostly
# relevant if the feed ever contains recurring VEVENTs.
LOOKBACK_DAYS=14
LOOKAHEAD_DAYS=120

# --- AeroAPI (live flight status) -----------------------------------------------
# Managed automatically by the "AeroAPI Key" and "Flight Info Source" forms on
# /calendar -- you shouldn't normally need to edit these by hand. They exist
# here so that configuration survives a full service restart (e.g. after a
# power outage) even if flifo.db is lost or reset; on startup, an empty
# database gets reseeded from whatever's saved here. LOCAL or AEROAPI.
AEROAPI_API_KEY=
AEROAPI_STATUS_SOURCE=LOCAL

# --- Storage -------------------------------------------------------------------
DB_PATH=flifo.db

# --- Web server ------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
